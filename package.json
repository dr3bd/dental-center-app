{
  "name": "dental-center-app",
  "private": true,
  "version": "0.1.0",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "dev:pwa": "npm run dev --workspace apps/pwa",
    "build:pwa": "npm run build --workspace apps/pwa",
    "dev:desktop": "npm run dev --workspace apps/desktop-electron",
    "build:desktop": "npm run build --workspace apps/desktop-electron",
    "test": "npm run test --workspace packages/core"
  },
  "devDependencies": {
    "typescript": "5.5.4"
  }
}
